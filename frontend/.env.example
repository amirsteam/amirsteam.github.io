# Frontend environment variables
# Copy this file to .env for local development. In production these are set
# in .github/workflows/deploy-frontend.yml.

# Backend API (Railway). Used for projects, skills, etc.; the site falls back
# to src/data/index.js when it can't be reached.
VITE_API_URL=https://your-railway-app.up.railway.app/api

# Web3Forms access key (https://web3forms.com). When set, the contact form
# emails you directly instead of posting to the backend. This key is public
# by design, so it is fine to commit.
VITE_WEB3FORMS_KEY=

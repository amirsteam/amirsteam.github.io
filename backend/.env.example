# Copy to .env for local development. On Render, set these in the dashboard.

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio

# Long random string used to sign admin logins (Render can generate one)
JWT_SECRET=change-me-to-a-long-random-string

# Sites allowed to call the API (comma separated)
ALLOWED_ORIGINS=https://www.amirlearner.me,http://localhost:5173,http://localhost:4173

# First admin account. Created on start-up only when no admin exists yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=pick-a-strong-password

# Publish button: a fine-grained GitHub token with "Contents: Read and write"
# on the amirsteam.github.io repository, and the repository name.
GITHUB_TOKEN=
GITHUB_REPO=amirsteam/amirsteam.github.io

# Fill an empty database with the site's current content on start-up
SEED_ON_START=true

PORT=5000
